<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_toolbar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/beacon_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_app" />

        <TextView
            android:id="@+id/app_status"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_install"
            style="@style/PluginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/install" />

        <Button
            android:id="@+id/btn_open"
            style="@style/PluginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_app" />

        <TextView
            style="@style/SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_beacon" />

        <TextView
            android:id="@+id/beacon_detail"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start"
                style="@style/PluginButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/start" />

            <Button
                android:id="@+id/btn_stop"
                style="@style/PluginButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stop" />
        </LinearLayout>

        <TextView
            style="@style/HintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pause_hint" />

        <TextView
            style="@style/SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_server" />

        <TextView
            style="@style/HintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_server_hint" />

        <Button
            android:id="@+id/btn_share"
            style="@style/PluginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_server" />

        <TextView
            android:id="@+id/message"
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/heading_yellow" />
    </LinearLayout>
</ScrollView>
